    # detect end of operation block: line at exactly 4 spaces indent starting a new key
    if op and re.match(r'^    [a-zA-Z]', l) and not re.match(r'^    (get|post|put|patch|delete):', l):
        if secl:
            print(f"{path}::{op}  SEC[{secl}]")
        op=None
