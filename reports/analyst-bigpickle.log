import re
def ops(fn):
    lines=open(fn).read().splitlines()
    end=next((i for i,l in enumerate(lines) if l.startswith('components:') or l.startswith('webhooks:')),len(lines))
    res=[]; in_paths=False; cur=None; i=0
    while i<end:
        l=lines[i]
        if re.match(r'^paths:\s*$',l): in_paths=True; i+=1; continue
        if in_paths and re.match(r'^  (/.*):$',l): cur=re.match(r'^  (/.*):$',l).group(1); i+=1; continue
        mm=re.match(r'^    (get|post|put|patch|delete):$',l)
        if in_paths and mm and cur:
            j=i+1; oauth=[]
            while j<end:
                s=lines[j]
                if re.match(r'^    [a-z]+:',s): break
                if re.match(r'^        - oauth2:',s):
                    k=j+1
                    while k<end and re.match(r'^            - ',lines[k]): oauth.append(lines[k].strip()); k+=1
                j+=1
            res.append((mm.group(1),cur,oauth)); i=j; continue
        i+=1
    return res
def diff(a,b,name):
    ka={(o[1]) for o in a}; kb={(o[1]) for o in b}
    print(f"\n== {name}: a={len(a)} b={len(b)}")
    print("paths added in B:", sorted(kb-ka))
    print("paths missing in B:", sorted(ka-kb))
diff(ops('sumup-openapi.yaml'),ops('oa31.yaml'),'openapi vs 31')
print("\n== common.yaml headers ==")
import re
for l in open('common.yaml').read().splitlines():
    if re.match(r'^  (get|post|put|patch|delete):|^  /',l): print(l)
