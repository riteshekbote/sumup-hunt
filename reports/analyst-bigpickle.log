import re
lines=open('sumup-openapi.yaml').read().splitlines()
path_end=next(idx for idx,l in enumerate(lines) if l.startswith('components:'))
i=0; in_paths=False; cur=None; results=[]
while i<path_end:
    l=lines[i]
    if re.match(r'^paths:\s*$',l): in_paths=True; i+=1; continue
    m=re.match(r'^  (/.*):$',l)
    if in_paths and m: cur=m.group(1); i+=1; continue
    mm=re.match(r'^    (get|post|put|patch|delete):$',l)
    if in_paths and mm and cur:
        op=mm.group(1); j=i+1
        oauth=[]; xsc=[]
        while j<path_end:
            s=lines[j]
            if re.match(r'^    [a-z]+:',s) and not re.match(r'^    (security|x-scopes):',s):
                if re.match(r'^    security:',s) or re.match(r'^    x-scopes:',s):
                    pass
                else: break
            if re.match(r'^        - oauth2:',s):
                k=j+1
                while k<path_end and re.match(r'^            - ',lines[k]):
                    oauth.append(lines[k][12:].strip()); k+=1
            if re.match(r'^      x-scopes:',s):
                k=j+1
                while k<path_end and re.match(r'^        - ',lines[k]):
                    xsc.append(lines[k][8:].strip()); k+=1
            j+=1
        results.append((op,cur,oauth,xsc)); i=j; continue
    i+=1
print("path-ops:",len(results))
all_sc=set()
for op,path,o,x in results:
    all_sc|=set(o); all_sc|=set(x)
print("all oauth/x-scope tokens:",sorted(all_sc))
print()
for op,path,o,x in results:
    flag="" if o==x else " <X-DIFF>"
    print(f"{op.upper():6} {path:62} oauth={o}  xscopes={x}{flag}")
