#!/bin/bash
# ccTLD legacy dashboard callback enumeration - raw curl, no -L
# HIT = redirect location NOT containing flows/oauth2/error
cctlds="sumup.co.uk sumup.de sumup.fr sumup.it sumup.es sumup.pt sumup.ie sumup.pl sumup.ro sumup.at sumup.ch sumup.nl sumup.se sumup.dk sumup.fi sumup.be"
hosts="app dashboard my secure me www"
for c in $cctlds; do
  for h in $hosts; do
    url="https://api.sumup.com/authorize?client_id=dashboard&redirect_uri=https://${h}.${c}/callback&response_type=code&scope=classic&state=test12345678"
    loc=$(curl -s -o /dev/null --max-time 20 -w '%{redirect_url}' "$url")
    if echo "$loc" | grep -q 'flows/oauth2/error'; then
      echo "MISS ${h}.${c} -> ${loc}"
    else
      echo "HIT?? ${h}.${c} -> ${loc}"
    fi
    sleep 1
  done
done
EOF
chmod +x cctld_probe.sh && echo "script ready"
script ready
