      "-H","Accept: application/json, text/event-stream","https://mcp.sumup.com/mcp"],capture_output=True,text=True)
    b=open("bb.txt").read()
    if "no applicable key" in b: return "ABSENT"
    if "signature verification failed" in b: return "**TRUSTED**"
    if "multiple matching keys" in b: return "NO_KID_TRYALL"
    if "Unsupported" in b: return "ALG_REJECTED"
    return "OTHER: "+b.strip()[:90]
