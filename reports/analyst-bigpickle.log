python3 - <<'PY'
import json,hashlib,collections
for h in ['auth.sumup.com','auth.sam-app.ro','auth-theta.sam-app.ro']:
    d=json.load(open(f'/tmp/jw_{h}.json'))['keys']
    print(f"\n===== {h}  ({len(d)} entries)")
    bykid=collections.defaultdict(list)
    for i,k in enumerate(d):
        mat = k.get('n','') + '|' + k.get('crv','') + '|' + k.get('x','')
        fp = hashlib.sha256(mat.encode()).hexdigest()[:16] if mat.strip('|') else 'no-key-mat'
        bykid[k.get('kid')].append((i,fp,k.get('kty'),k.get('alg'),k.get('use')))
    for kid,lst in bykid.items():
        tag = '  <== DUPLICATE KID' if len(lst)>1 else ''
        print(f"  kid={kid}{tag}")
        for i,fp,kty,alg,use in lst:
            print(f"     idx={i} kty={kty} alg={alg} use={use} keyfp={fp}")
    dups={k:v for k,v in bykid.items() if len(v)>1}
    if dups:
        for kid,lst in dups.items():
            fps={x[1] for x in lst}
            print(f"  VERDICT {kid}: {len(lst)} entries, {len(fps)} distinct key material -> "
                  + ("IDENTICAL key material (benign duplicate)" if len(fps)==1 else "*** DIFFERENT KEY MATERIAL UNDER ONE KID (real key-selection hazard) ***"))
