d = yaml.safe_load(open('sumup-openapi.yaml'))
paths = d.get('paths', {})
print("TOTAL PATHS:", len(paths))
ops = []
for p, items in paths.items():
    for m, op in items.items():
        if m in ('get','post','put','delete','patch'):
            scopes = None
            sec = op.get('security')
            if sec:
                scopes = [list(s.values()) for s in sec]
            ops.append((p, m, op.get('operationId',''), scopes))
# print ops NOT already in KB-cataloged set
for p,m,oid,scopes in ops:
    hidden = any(s == [] or (isinstance(s,list) and all(not x for x in s)) for s in (scopes or []))
    print(f"{m.upper():6} {p:70} {oid:45} scope={scopes} empty_scope={hidden}")
