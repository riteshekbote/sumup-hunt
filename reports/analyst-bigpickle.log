import yaml, sys
spec = yaml.safe_load(open('spec.yaml'))
sec_schemes = spec.get('components',{}).get('securitySchemes',{})
print("SEC SCHEMES:", list(sec_schemes.keys()))
print()
# catalog every op and its security
for path, ops in spec.get('paths',{}).items():
    for method, op in ops.items():
        if method not in ('get','post','put','patch','delete'):
            continue
        sec = op.get('security', spec.get('security'))
        # describe scopes per scheme
        out=[]
        for s in (sec or []):
            for sch, scps in s.items():
                out.append(f"{sch}={scps}")
        print(f"{method.upper():6} {path}")
        for o in out: print("       ", o)
EOF
