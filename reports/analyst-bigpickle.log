import re
lines = open('sumup-openapi.yaml').read().splitlines()
cur_path=None
ops=[]
i=0
while i < len(lines):
    l=lines[i]
    m=re.match(r'^  (/\S+):$', l)
    if m:
        cur_path=m.group(1)
    if cur_path:
        mm=re.match(r'^    (get|post|put|patch|delete):$', l)
        if mm:
            method=mm.group(1)
            j=i+1
            scopes=None
            oauth2='?'
            while j < len(lines) and not re.match(r'^    [a-z]+:', lines[j]) and not re.match(r'^  /\S+', lines[j]):
                if re.match(r'^      x-scopes:', lines[j]):
                    scopes=lines[j].split(':',1)[1].strip()
                if re.match(r'^          - oauth2:', lines[j]):
                    k=j
                    oauth2='[]'
                    buf=[]
                    k+=1
                    while k < len(lines) and re.match(r'^              - |^            oauth2:', lines[k]):
                        buf.append(lines[k].strip())
                        k+=1
                    if buf:
                        oauth2=';'.join(buf)
                    j=k-1
                j+=1
            ops.append((method,cur_path,scopes,oauth2))
    i+=1
print(f"total ops: {len(ops)}")
