        s = op.get('security')
        if s == []:
            nosec.append((m.upper(),p))
        elif s is None:
            nosec.append((m.upper(),p,'(no security field)'))
        tags=set()
        if s:
            for it in s:
                for sc in it:
                    if sc=='oauth2':
                        sl=it[sc]
                        if sl==[]: empty_scope.append((m.upper(),p))
                        tags.add('oauth2:'+",".join(sl))
                    if sc=='apiKey':
