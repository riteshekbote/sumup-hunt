import base64,json,subprocess,urllib.request
def b64(b): return base64.urlsafe_b64encode(b).rstrip(b'=').decode()
def jwt(kid,alg,sub='1'):
    h={"alg":alg,"typ":"JWT"}
    if kid: h["kid"]=kid
    return f"{b64(json.dumps(h).encode())}.{b64(json.dumps({'sub':sub,'aud':'mcp.sumup.com'}).encode())}.{b64(b'notarealsignature')}"
