name: Sync Issues (SumUp Payments Limited / SumUp Group)

on:
  workflow_run:
    workflows: ["Deep Hunt (SumUp Payments Limited / SumUp Group)"]
    types: [completed]
  workflow_dispatch:

permissions:
  issues: write
  contents: read

concurrency:
