import re
txt = open('/tmp/opencode/sumup.yaml').read()
# find path blocks
path_re = re.compile(r'^  (/[^\s]*):\s*$', re.M)
lines = txt.splitlines()
cur = None
ops = {}
for i, ln in enumerate(lines):
    m = re.match(r'^  (/.*):$', ln)
    if m:
        cur = m.group(1)
        continue
    if cur is None:
        continue
    m2 = re.match(r'^    (get|put|post|delete|patch|head|options):$', ln)
    if m2:
        curm = m2.group(1)
        ops.setdefault(cur, {})[curm] = None
        continue
    if re.match(r'^      security:\s*$', ln):
        # capture following lines until a line not starting with spaces+dash/brace
        j = i+1
        sec = []
        while j < len(lines) and re.match(r'^        ', lines[j]):
            sec.append(lines[j].strip())
            j += 1
        ops.setdefault(cur, {}).setdefault('sec', []).append((curm, sec))
    if re.match(r'^    (get|put|post|delete|patch|head|options):', ln):
        curm = m2.group(1) if m2 else None
# print ops where security is empty list oauth2:[] or apiKey:[]
for p, d in ops.items():
    for method, sec in d.get('sec', []):
        s = " ".join(sec)
        if 'oauth2: []' in s or 'apiKey: []' in s:
            print(f"{method.upper()} {p} -> {s}")
