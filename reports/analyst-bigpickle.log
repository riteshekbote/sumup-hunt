        cmd=["curl","-s","-m","15","-o","/tmp/opencode/sumup/b.txt","-w","%{http_code}|%{content_type}|%{size_download}","https://api.sam-app.ro"+p]
        if tok: cmd[1:1]=["-H",f"Authorization: {tok}"]
