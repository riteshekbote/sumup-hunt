import json
docs={h:json.load(open(f'/tmp/oc_{h}.json')) for h in ['auth.sumup.com','auth.sam-app.ro','auth-theta.sam-app.ro']}
allk=set()
for d in docs.values(): allk |= set(d.get('scopes_supported',[]))
print(f"{'scope':<34}{'prod':<7}{'staging':<9}{'theta'}")
print('-'*60)
for s in sorted(allk):
    print(f"{s:<34}{'Y' if s in docs['auth.sumup.com'].get('scopes_supported',[]) else '-':<7}"
          f"{'Y' if s in docs['auth.sam-app.ro'].get('scopes_supported',[]) else '-':<9}"
          f"{'Y' if s in docs['auth-theta.sam-app.ro'].get('scopes_supported',[]) else '-'}")
print()
for h,d in docs.items():
    print(f"{h}: {len(d.get('scopes_supported',[]))} scopes | auth_methods={d.get('token_endpoint_auth_methods_supported')}")
    print(f"   grant_types={d.get('grant_types_supported')}")
    print(f"   registration_endpoint={d.get('registration_endpoint','<absent>')}  revocation={d.get('revocation_endpoint','<absent>')}")
p=set(docs['auth.sumup.com']['scopes_supported']); 
for h in ['auth.sam-app.ro','auth-theta.sam-app.ro']:
    e=set(docs[h]['scopes_supported'])
    print(f"\n{h} NOT in prod ({len(e-p)}): {sorted(e-p)}")
    print(f"prod NOT in {h} ({len(p-e)}): {sorted(p-e)}")
