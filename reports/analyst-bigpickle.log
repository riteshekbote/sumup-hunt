          "public:00000000-0000-0000-0000-000000000000","","public:1zsCqlo880BCW-SH7nRnaSHoDk9SHWvJ5fNiztx5QGM",
          "public:-tfiDUnEWW4Kz5Jqt0T-q85aqJkYkZsx0n3qPa-6sw4","1zsCqlo880BCW-SH7nRnaSHoDk9SHWvJ5fNiztx5QGM"]:
    cands.append(("other-guess",k))
present=[]; absent=[]; other=[]
for origin,kid in cands:
    r=probe("RS256",kid)
    (present if r=="**TRUSTED**" else absent if r=="ABSENT" else other).append((origin,kid,r))
    print(f"  {origin:14} kid={kid[:52]:54} -> {r}")
    time.sleep(1)
print(f"\nTRUSTED={len(present)} ABSENT={len(absent)} OTHER={len(other)}")
