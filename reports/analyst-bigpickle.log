print("\n--- alg matrix, no kid (try-all path) ---")
for alg in ["RS256","RS384","RS512","PS256","ES256","EdDSA","HS256","none"]:
    print(f"  alg={alg:6} -> {probe(alg,None)}"); time.sleep(1)
