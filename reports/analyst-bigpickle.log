while IFS=$'\t' read -r name url dig; do
  f="skill_${name}.zip"
  curl -sS -o "$f" -w "" --max-time 30 "$url"
  actual="sha256:$(sha256sum "$f" | cut -d' ' -f1)"
  sz=$(wc -c < "$f")
  if [ "$actual" = "$dig" ]; then verdict="MATCH"; else verdict="*** MISMATCH ***"; fi
  printf '%-24s %8s B  %s  %s\n' "$name" "$sz" "$verdict" "$actual"
  sleep 1
done < skills.tsv
